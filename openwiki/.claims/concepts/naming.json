    {
      "id": "claim_583a9e06696a419492fb631ecf4363bb",
      "statement": "The NameAllocator class is responsible for assigning unique Java identifier names to all code elements during generation, preventing identifier collisions by appending underscores when conflicts occur.",
      "evidence": [
        {
          "resource": "repo://src/main/java/com/squareup/javapoet/NameAllocator.java#L18-L76",
          "version": "repo-lines-v1:sha256:c331d4e7bbdc712b2c7d0b6d2185be5c11c531bf61d1c04804b594b1cdbad2ff:"
        }
      ]
    },
    {
      "id": "claim_93673c1ad0034cf98ccfc52bba8986ac",
      "statement": "The NameAllocator maintains two data structures: an allocatedNames set to track all issued names and a tagToName map to associate each unique tag with its allocated name for stable lookup.",
      "evidence": [
        {
          "resource": "repo://src/main/java/com/squareup/javapoet/NameAllocator.java#L79-L84",
          "version": "repo-lines-v1:sha256:587047b39b53d56f0515b11c4761013d5fecd8b51076ada55f746a5cf94e61ab:"
        }
      ]
    },
    {
      "id": "claim_2cffd17fbd804aef960e5824e53f79f8",
      "statement": "When newName(suggestion, tag) is called, the suggestion is converted into a valid Java identifier using toJavaIdentifier(), which prefixes with underscore if the first character is invalid but part-safe and replaces all non-part characters with underscores.",
      "evidence": [
        {
          "resource": "repo://src/main/java/com/squareup/javapoet/NameAllocator.java#L128-L143",
          "version": "repo-lines-v1:sha256:0e313588a20266a097a65b6b7e8824124c3c89422e37b0d4fe8cfcd3ad980bc9:"
        }
      ]
    },
    {
      "id": "claim_46c3985170414f97878a4d2e9dfee9f2",
      "statement": "If a suggested name is a Java keyword or already allocated, NameAllocator appends an underscore and retries until a valid name is produced.",
      "evidence": [
        {
          "resource": "repo://src/main/java/com/squareup/javapoet/NameAllocator.java#L112-L126",
          "version": "repo-lines-v1:sha256:ebc341194a0babf53150bcd90d16ab26d5bd7b652dfdb69dad7552be9c1a76fc:"
        }
      ]
    },
    {
      "id": "claim_d808f4804878403aac399a253b798957",
      "statement": "Each tag can be associated with exactly one allocated name; reusing a tag for different suggestions throws an IllegalArgumentException.",
      "evidence": [
