          "version": "repo-lines-v1:sha256:f245a5b7ccb1d7238e499338ae3c952a8fe45994d7b0dc97331d43134826ed68:"
        }
      ]
    },
    {
      "id": "claim_284b3e45ba3f4e4dba6f3cef5362fe74",
      "statement": "Varargs methods require that the last parameter be an array type; this invariant is checked during construction and violations throw an exception.",
