    {
      "id": "claim_3c5cc32c59074ce4922d98be2706d208",
      "statement": "The static factory `overriding(ExecutableElement)` copies metadata (modifiers, type parameters, return type, name, parameter types, throws declarations) from a reflected method but does not copy annotations; it adds @Override automatically.",
