  "claims": [
    {
      "id": "claim_349746aa10d54da5b62832fc2431227b",
      "statement": "MethodSpec is an immutable value object that represents a complete method or constructor declaration, including name, annotations, modifiers, type variables, return type, parameters, varargs flag, exceptions, inline code body, and optional default value.",
      "evidence": [
        {
          "resource": "repo://src/main/java/com/squareup/javapoet/MethodSpec.java#L18-L76",
          "version": "repo-lines-v1:sha256:821dd2f1b892cd25bb7fb7298de96f71b3a419eb87d8f18c3633c99a2bd4b0e5:"
        }
      ]
    },
    {
      "id": "claim_ef7570bd4d7249aa83471df9e0566a47",
      "statement": "MethodSpec is constructed via a fluent Builder pattern through factory methods `methodBuilder(name)` or `constructorBuilder()` and becomes immutable upon calling `build()`.",
      "evidence": [
        {
          "resource": "repo://src/main/java/com/squareup/javapoet/MethodSpec.java#L189-L203",
          "version": "repo-lines-v1:sha256:786bbc99cc29b8698675b175dbd8c8b0a58e4d290f277b66521edb3bad54503c:"
        }
      ]
    },
    {
      "id": "claim_21773a877a7d45348e944ba7911b2d56",
      "statement": "Constructors are identified by the special name \"<init>\" and cannot have a return type; attempting to set one throws an error.",
